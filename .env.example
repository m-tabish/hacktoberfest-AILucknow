# Copy to .env and fill in. Without LLM_API_KEY the system still answers
# cell_lookup / abstain questions and returns a low-confidence fallback otherwise.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Leave unset to auto-detect. Set to cpu on macOS < 15 (MPS crashes there).
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_PAGES=5
